+<script>
+/* =========================================================
+   0. Auth gate
+   ========================================================= */
+(async function authGate() {
+  try {
+    const resp = await fetch('/api/admin/me');
+    const data = await resp.json();
+    if (!data.authenticated) {
+      window.location.href = 'login.html';
+      return;
+    }
+    document.getElementById('authGate').style.display = 'none';
+    document.getElementById('dashboardRoot').style.display = 'block';
+    initDashboard();
+  } catch (err) {
+    window.location.href = 'login.html';
+  }
+})();
+
+document.getElementById('logoutBtn').addEventListener('click', async () => {
+  await fetch('/api/admin/logout', { method: 'POST' });
+  window.location.href = 'login.html';
+});
+
+/* =========================================================
+   1. Tabs
+   ========================================================= */
+document.querySelectorAll('.admin-tab-btn').forEach(btn => {
+  btn.addEventListener('click', () => {
+    document.querySelectorAll('.admin-tab-btn').forEach(b => b.classList.remove('active'));
+    btn.classList.add('active');
+    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
+    document.getElementById('panel-' + btn.dataset.tab).classList.add('active');
+    if (btn.dataset.tab === 'analytics') loadAnalytics();
+  });
+});
+
+/* =========================================================
+   2. Toast helper
+   ========================================================= */
+function showToast(msg, isError) {
+  const t = document.getElementById('toast');
+  t.textContent = msg;
+  t.className = 'toast show' + (isError ? ' error' : '');
+  setTimeout(() => { t.className = 'toast'; }, 3200);
+}
+
+/* =========================================================
+   3. Analytics
+   ========================================================= */
+let analyticsLoaded = false;
+
+async function loadAnalytics() {
+  const el = document.getElementById('analyticsContent');
+  el.innerHTML = '<div class="empty-state">Loading analytics…</div>';
+  try {
+    const resp = await fetch('/api/admin/analytics');
+    const data = await resp.json();
+
+    if (!data.configured) {
+      el.innerHTML = `
+        <div class="ga-setup-notice">
+          <i class="bi bi-bar-chart-line"></i>
+          <h3 style="color:#fff; margin-bottom:0.6rem; font-family:'Syne',sans-serif;">Google Analytics not connected yet</h3>
+          <p style="max-width:480px; margin:0 auto 1rem;">
+            Add <code>GA_PROPERTY_ID</code>, <code>GA_CLIENT_EMAIL</code> and <code>GA_PRIVATE_KEY</code>
+            as environment variables in your Vercel project, then refresh this page to see real traffic data here.
+          </p>
+        </div>`;
+      return;
+    }
+
+    if (data.error) {
+      el.innerHTML = `<div class="ga-setup-notice"><i class="bi bi-exclamation-triangle"></i>
+        <h3 style="color:#fff;">Couldn't load analytics</h3><p>${escapeHtml(data.error)}</p></div>`;
+      return;
+    }
+
+    renderAnalytics(data);
+  } catch (err) {
+    el.innerHTML = '<div class="ga-setup-notice"><i class="bi bi-exclamation-triangle"></i><p>Network error loading analytics.</p></div>';
+  }
+}
+
+function gaVal(report, rowIndex, metricIndex) {
+  try { return Number(report.rows[rowIndex].metricValues[metricIndex].value) || 0; }
+  catch { return 0; }
+}
+
+function renderAnalytics(data) {
+  const el = document.getElementById('analyticsContent');
+  const s = data.summary;
+  const hasSummaryRow = s.rows && s.rows.length > 0;
+  const users = hasSummaryRow ? gaVal(s, 0, 0) : 0;
+  const views = hasSummaryRow ? gaVal(s, 0, 1) : 0;
+  const sessions = hasSummaryRow ? gaVal(s, 0, 2) : 0;
+  const avgDur = hasSummaryRow ? gaVal(s, 0, 3) : 0;
+
+  el.innerHTML = `
+    <div class="stat-grid">
+      <div class="stat-tile"><div class="stat-label">Active Users</div><div class="stat-value">${users.toLocaleString()}</div></div>
+      <div class="stat-tile"><div class="stat-label">Page Views</div><div class="stat-value">${views.toLocaleString()}</div></div>
+      <div class="stat-tile"><div class="stat-label">Sessions</div><div class="stat-value">${sessions.toLocaleString()}</div></div>
+      <div class="stat-tile"><div class="stat-label">Avg. Session</div><div class="stat-value">${formatDuration(avgDur)}</div></div>
+    </div>
+    <div class="analytics-grid">
+      <div class="card">
+        <h3>Users &amp; Page Views Over Time</h3>
+        <canvas id="trafficChart"></canvas>
+      </div>
+      <div class="card">
+        <h3>Top Pages</h3>
+        <div id="topPagesList"></div>
+      </div>
+      <div class="card">
+        <h3>Device Breakdown</h3>
+        <div id="deviceList"></div>
+      </div>
+      <div class="card">
+        <h3>Top Countries</h3>
+        <div id="countryList"></div>
+      </div>
+    </div>
+  `;
+
+  drawTrafficChart(data.byDate);
+  renderBarList('topPagesList', data.topPages, (row) => row.dimensionValues[0].value.replace(/\.html$/, '') || '/');
+  renderBarList('deviceList', data.devices, (row) => row.dimensionValues[0].value);
+  renderBarList('countryList', data.countries, (row) => row.dimensionValues[0].value);
+}
+
+function renderBarList(containerId, report, labelFn) {
+  const container = document.getElementById(containerId);
+  const rows = (report && report.rows) || [];
+  if (rows.length === 0) {
+    container.innerHTML = '<div class="empty-state" style="padding:1rem;">No data yet</div>';
+    return;
+  }
+  const max = Math.max(...rows.map(r => Number(r.metricValues[0].value) || 0), 1);
+  container.innerHTML = rows.map(r => {
+    const val = Number(r.metricValues[0].value) || 0;
+    const pct = Math.max(4, Math.round((val / max) * 100));
+    return `<div class="bar-row">
+      <div class="bar-label" title="${escapeHtml(labelFn(r))}">${escapeHtml(labelFn(r))}</div>
+      <div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div>
+      <div class="bar-value">${val.toLocaleString()}</div>
+    </div>`;
+  }).join('');
+}
+
+function drawTrafficChart(report) {
+  const canvas = document.getElementById('trafficChart');
+  if (!canvas) return;
+  const rows = (report && report.rows) || [];
+  const dpr = window.devicePixelRatio || 1;
+  const cssWidth = canvas.parentElement.clientWidth - 48;
+  const cssHeight = 220;
+  canvas.width = cssWidth * dpr;
+  canvas.height = cssHeight * dpr;
+  canvas.style.width = cssWidth + 'px';
+  canvas.style.height = cssHeight + 'px';
+  const ctx = canvas.getContext('2d');
+  ctx.scale(dpr, dpr);
+  ctx.clearRect(0, 0, cssWidth, cssHeight);
+
+  if (rows.length === 0) {
+    ctx.fillStyle = '#8892b0';
+    ctx.font = '13px Inter';
+    ctx.fillText('No data yet', 10, cssHeight / 2);
+    return;
+  }
+
+  const values = rows.map(r => Number(r.metricValues[1].value) || 0); // pageviews
+  const max = Math.max(...values, 1);
+  const padding = 20;
+  const w = cssWidth - padding * 2;
+  const h = cssHeight - padding * 2;
+  const stepX = w / Math.max(values.length - 1, 1);
+
+  // gridlines
+  ctx.strokeStyle = 'rgba(255,255,255,0.06)';
+  ctx.lineWidth = 1;
+  for (let i = 0; i <= 3; i++) {
+    const y = padding + (h / 3) * i;
+    ctx.beginPath(); ctx.moveTo(padding, y); ctx.lineTo(cssWidth - padding, y); ctx.stroke();
+  }
+
+  // area fill
+  const grad = ctx.createLinearGradient(0, padding, 0, padding + h);
+  grad.addColorStop(0, 'rgba(0,210,255,0.35)');
+  grad.addColorStop(1, 'rgba(0,210,255,0)');
+  ctx.beginPath();
+  values.forEach((v, i) => {
+    const x = padding + i * stepX;
+    const y = padding + h - (v / max) * h;
+    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
+  });
+  ctx.lineTo(padding + (values.length - 1) * stepX, padding + h);
+  ctx.lineTo(padding, padding + h);
+  ctx.closePath();
+  ctx.fillStyle = grad;
+  ctx.fill();
+
+  // line
+  ctx.beginPath();
+  values.forEach((v, i) => {
+    const x = padding + i * stepX;
+    const y = padding + h - (v / max) * h;
+    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
+  });
+  ctx.strokeStyle = '#00d2ff';
+  ctx.lineWidth = 2;
+  ctx.stroke();
+}
+
+function formatDuration(seconds) {
+  const m = Math.floor(seconds / 60);
+  const s = Math.round(seconds % 60);
+  return `${m}m ${s}s`;
+}
+
+function escapeHtml(str) {
+  return String(str).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+}
+
+document.getElementById('refreshAnalyticsBtn').addEventListener('click', loadAnalytics);
+
+/* =========================================================
+   4. Portfolio works manager
+   ========================================================= */
+let worksData = [];
+let isDirty = false;
+let editingIndex = null; // null = adding new
+let currentGallery = [];
+
+function setDirty(dirty) {
+  isDirty = dirty;
+  const ind = document.getElementById('saveIndicator');
+  if (dirty) {
+    ind.textContent = 'Unsaved changes';
+    ind.className = 'save-indicator dirty';
+  } else {
+    ind.textContent = 'All changes saved';
+    ind.className = 'save-indicator saved';
+  }
+}
+
+async function loadWorks() {
+  try {
+    const resp = await fetch('/api/portfolio');
+    const data = await resp.json();
+    worksData = (data && data.works) || [];
+    renderWorksTable();
+  } catch (err) {
+    showToast('Failed to load portfolio data.', true);
+  }
+}
+
+const catLabels = {
+  uiux: 'UI/UX', video: 'Video', photo: 'Photo Editing',
+  manipulation: 'Image Manipulation', '3d': '3D Modeling', graphic: 'Graphic Design'
+};
+
+function renderWorksTable() {
+  const tbody = document.getElementById('worksTableBody');
+  const filterCat = document.getElementById('categoryFilter').value;
+  const search = document.getElementById('searchInput').value.trim().toLowerCase();
+
+  const filtered = worksData
+    .map((w, idx) => ({ w, idx }))
+    .filter(({ w }) => (filterCat === 'all' || w.category === filterCat))
+    .filter(({ w }) => !search || (w.title || '').toLowerCase().includes(search) || (w.title_zh || '').toLowerCase().includes(search));
+
+  document.getElementById('worksEmptyState').style.display = filtered.length ? 'none' : 'block';
+
+  tbody.innerHTML = filtered.map(({ w, idx }) => `
+    <tr>
+      <td><img class="thumb" src="${escapeHtml(w.thumbnail || '')}" onerror="this.src='../Image/Logo_Colour.png'"></td>
+      <td>${escapeHtml(w.title || '')}</td>
+      <td><span class="cat-pill">${catLabels[w.category] || w.category}</span></td>
+      <td>${escapeHtml(w.year || '')}</td>
+      <td>${escapeHtml(w.client || '')}</td>
+      <td>
+        <div class="row-actions" style="justify-content:flex-end;">
+          <button onclick="editWork(${idx})" title="Edit"><i class="bi bi-pencil"></i></button>
+          <button class="del" onclick="deleteWork(${idx})" title="Delete"><i class="bi bi-trash"></i></button>
+        </div>
+      </td>
+    </tr>
+  `).join('');
+}
+
+document.getElementById('categoryFilter').addEventListener('change', renderWorksTable);
+document.getElementById('searchInput').addEventListener('input', renderWorksTable);
+
+function deleteWork(idx) {
+  if (!confirm('Delete "' + (worksData[idx].title || 'this work') + '"? This can\'t be undone once you save.')) return;
+  worksData.splice(idx, 1);
+  renderWorksTable();
+  setDirty(true);
+}
+
+function openModal(isEdit) {
+  document.getElementById('modalTitle').textContent = isEdit ? 'Edit Work' : 'Add New Work';
+  document.getElementById('editModalOverlay').classList.add('open');
+}
+function closeModal() {
+  document.getElementById('editModalOverlay').classList.remove('open');
+}
+
+function editWork(idx) {
+  editingIndex = idx;
+  const w = worksData[idx];
+  document.getElementById('f-category').value = w.category || 'uiux';
+  document.getElementById('f-year').value = w.year || '';
+  document.getElementById('f-title').value = w.title || '';
+  document.getElementById('f-title_zh').value = w.title_zh || '';
+  document.getElementById('f-description').value = w.description || '';
+  document.getElementById('f-description_zh').value = w.description_zh || '';
+  document.getElementById('f-tools').value = w.tools || '';
+  document.getElementById('f-client').value = w.client || '';
+  document.getElementById('f-client_zh').value = w.client_zh || '';
+  document.getElementById('f-youtube_id').value = w.youtube_id || '';
+  document.getElementById('f-figma_link').value = w.figma_link || '';
+  document.getElementById('f-thumbnail').value = w.thumbnail || '';
+  document.getElementById('thumbPreview').src = w.thumbnail || '';
+  currentGallery = Array.isArray(w.gallery) ? [...w.gallery] : [];
+  renderGalleryGrid();
+  openModal(true);
+}
+
+document.getElementById('addWorkBtn').addEventListener('click', () => {
+  editingIndex = null;
+  document.getElementById('workForm').reset();
+  document.getElementById('f-thumbnail').value = '';
+  document.getElementById('thumbPreview').src = '';
+  currentGallery = [];
+  renderGalleryGrid();
+  openModal(false);
+});
+
+document.getElementById('cancelModalBtn').addEventListener('click', closeModal);
+document.getElementById('editModalOverlay').addEventListener('click', (e) => {
+  if (e.target.id === 'editModalOverlay') closeModal();
+});
+
+function renderGalleryGrid() {
+  const grid = document.getElementById('galleryGrid');
+  grid.innerHTML = currentGallery.map((url, i) => `
+    <div class="gallery-item">
+      <img src="${escapeHtml(url)}">
+      <button type="button" class="rm-btn" onclick="removeGalleryImage(${i})">✕</button>
+    </div>
+  `).join('');
+}
+function removeGalleryImage(i) {
+  currentGallery.splice(i, 1);
+  renderGalleryGrid();
+}
+
+/* ---- Image upload helpers (base64 JSON upload, max ~3.5MB) ---- */
+function fileToBase64(file) {
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(reader.result.split(',')[1]);
+    reader.onerror = reject;
+    reader.readAsDataURL(file);
+  });
+}
+
+async function uploadImage(file, statusEl) {
+  if (file.size > 3.5 * 1024 * 1024) {
+    throw new Error('File is ' + (file.size / 1024 / 1024).toFixed(1) + 'MB — please compress/resize it under 3.5MB first.');
+  }
+  if (statusEl) statusEl.textContent = 'Uploading…';
+  const dataBase64 = await fileToBase64(file);
+  const resp = await fetch('/api/admin/upload', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ filename: file.name, contentType: file.type, dataBase64 }),
+  });
+  const data = await resp.json();
+  if (!resp.ok) throw new Error(data.error || 'Upload failed.');
+  if (statusEl) statusEl.textContent = 'Uploaded ✓';
+  return data.url;
+}
+
+document.getElementById('thumbUploadBtn').addEventListener('click', () => document.getElementById('thumbFileInput').click());
+document.getElementById('thumbFileInput').addEventListener('change', async (e) => {
+  const file = e.target.files[0];
+  if (!file) return;
+  const statusEl = document.getElementById('thumbUploadStatus');
+  try {
+    const url = await uploadImage(file, statusEl);
+    document.getElementById('f-thumbnail').value = url;
+    document.getElementById('thumbPreview').src = url;
+  } catch (err) {
+    statusEl.textContent = err.message;
+    showToast(err.message, true);
+  }
+  e.target.value = '';
+});
+
+document.getElementById('galleryUploadBtn').addEventListener('click', () => document.getElementById('galleryFileInput').click());
+document.getElementById('galleryFileInput').addEventListener('change', async (e) => {
+  const file = e.target.files[0];
+  if (!file) return;
+  try {
+    const url = await uploadImage(file, null);
+    currentGallery.push(url);
+    renderGalleryGrid();
+  } catch (err) {
+    showToast(err.message, true);
+  }
+  e.target.value = '';
+});
+
+document.getElementById('workForm').addEventListener('submit', (e) => {
+  e.preventDefault();
+  const thumbnail = document.getElementById('f-thumbnail').value.trim();
+  if (!thumbnail) {
+    showToast('Please upload a thumbnail image first.', true);
+    return;
+  }
+  const work = {
+    category: document.getElementById('f-category').value,
+    title: document.getElementById('f-title').value.trim(),
+    title_zh: document.getElementById('f-title_zh').value.trim(),
+    description: document.getElementById('f-description').value.trim(),
+    description_zh: document.getElementById('f-description_zh').value.trim(),
+    tools: document.getElementById('f-tools').value.trim(),
+    year: document.getElementById('f-year').value.trim(),
+    client: document.getElementById('f-client').value.trim(),
+    client_zh: document.getElementById('f-client_zh').value.trim(),
+    thumbnail,
+  };
+  const youtubeId = document.getElementById('f-youtube_id').value.trim();
+  const figmaLink = document.getElementById('f-figma_link').value.trim();
+  if (youtubeId) work.youtube_id = youtubeId;
+  if (figmaLink) work.figma_link = figmaLink;
+  if (currentGallery.length) work.gallery = [...currentGallery];
+
+  if (editingIndex === null) {
+    worksData.unshift(work); // newest-first, matches homepage "latest per category" logic
+  } else {
+    worksData[editingIndex] = work;
+  }
+  renderWorksTable();
+  setDirty(true);
+  closeModal();
+});
+
+document.getElementById('saveAllBtn').addEventListener('click', async () => {
+  const btn = document.getElementById('saveAllBtn');
+  btn.disabled = true;
+  btn.textContent = 'Saving…';
+  try {
+    const resp = await fetch('/api/portfolio', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ works: worksData }),
+    });
+    const data = await resp.json();
+    if (!resp.ok) throw new Error(data.error || 'Save failed.');
+    setDirty(false);
+    showToast('Saved ' + data.count + ' works — live on the site now.');
+  } catch (err) {
+    showToast(err.message, true);
+  } finally {
+    btn.disabled = false;
+    btn.innerHTML = '<i class="bi bi-cloud-arrow-up"></i> Save Changes';
+  }
+});
+
+window.addEventListener('beforeunload', (e) => {
+  if (isDirty) { e.preventDefault(); e.returnValue = ''; }
+});
+
+/* =========================================================
+   5. Init
+   ========================================================= */
+function initDashboard() {
+  loadWorks();
+  loadAnalytics();
+}
+</script>
+
 </body>
