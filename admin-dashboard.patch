+    padding: 2.5rem 2rem;
+    box-shadow: 0 20px 50px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.08);
+    text-align: center;
+  }
+  .login-card img { height: 40px; margin-bottom: 1.5rem; }
+  .login-card h1 {
+    font-family: 'Syne', sans-serif;
+    font-size: 1.4rem;
+    font-weight: 800;
+    margin-bottom: 0.4rem;
+  }
+  .login-card p.sub { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.8rem; }
+  .field { text-align: left; margin-bottom: 1.2rem; }
+  .field label {
+    display: block;
+    font-size: 0.72rem;
+    text-transform: uppercase;
+    letter-spacing: 0.1em;
+    color: var(--text-muted);
+    margin-bottom: 0.4rem;
+    font-weight: 600;
+  }
+  .field input {
